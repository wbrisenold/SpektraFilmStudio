# BUILD.bazel — SpektraFilmStudio targets (Intel x86_64, macOS 15.0+)
# Load rules from Bzlmod-managed dependencies

load("@rules_swift//swift:swift.bzl", "swift_library", "swift_binary")
load("@build_bazel_rules_apple//apple:macos.bzl", "macos_application", "apple_resource_group")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_binary")

package(default_visibility = ["//visibility:public"])

# =========================================================================
# Native Metal Renderer (C++/Objective-C++)
# =========================================================================

cc_library(
    name = "spektra_native_core",
    srcs = [
        "Native/src/SpektraAppBridge.mm",
        "Native/src/SpektraMetalRenderer.mm",
    ],
    hdrs = [
        "Native/src/SpektraAppBridge.h",
        "Native/src/SpektraMetalRenderer.h",
        "Native/src/SpektraParameters.h",
        "Native/src/SpektraRenderer.h",
    ],
    includes = [
        "Native/src",
        "//generated_curves",
    ],
    deps = [
        "//generated_curves",
        "@onnxruntime//:onnxruntime",  # for header paths only
    ],
    copts = [
        "-std=c++17",
        "-O3",
        "-DNDEBUG",
        "-mmacosx-version-min=15.0",
        "-arch", "x86_64",
        "-fobjc-arc",
        "-Iexternal/onnxruntime/include",
    ],
    linkopts = [
        "-framework", "Metal",
        "-framework", "MetalKit",
        "-framework", "MetalPerformanceShaders",
        "-framework", "Foundation",
    ],
    linkshared = False,
)

# =========================================================================
# Rust Core (spektrastudio-core) — pre-built via Cargo
# =========================================================================

cc_library(
    name = "spektrastudio_core",
    srcs = [],
    hdrs = [],
    linkstatic = True,
    linkopts = [
        "-L/Users/A1990/Downloads/SpektraFilmStudio/.build/spektrastudio-core/x86_64-apple-darwin/release",
        "-lspektrastudio_core",
    ],
    visibility = ["//visibility:public"],
)

# =========================================================================
# Swift System Libraries (module maps)
# =========================================================================

swift_library(
    name = "spektra_bridge",
    module_name = "CSpektraBridge",
    srcs = glob(["Sources/CSpektraBridge/*.{swift,h,m,mm,c,cpp}"]),
    module_map = "Sources/CSpektraBridge/module.modulemap",
    deps = [
        ":spektra_native_core",
    ],
)

swift_library(
    name = "studio_core_bridge",
    module_name = "CSpektraStudioCore",
    srcs = glob(["Sources/CSpektraStudioCore/*.{swift,h,m,mm,c,cpp}"]),
    module_map = "Sources/CSpektraStudioCore/module.modulemap",
    deps = [
        ":spektrastudio_core",
    ],
)

swift_library(
    name = "semantic_mask_native",
    module_name = "SemanticMaskNative",
    srcs = glob(["Sources/SemanticMaskNative/**/*.{swift,h,m,mm,c,cpp}"]),
    module_map = "Sources/SemanticMaskNative/include/module.modulemap",
    copts = [
        "-Iexternal/onnxruntime/include",
    ],
    linkopts = [
        "-Lexternal/onnxruntime/lib",
        "-lonnxruntime",
    ],
    deps = [
        "@onnxruntime//:onnxruntime",
    ],
)

# =========================================================================
# Main App Library
# =========================================================================

swift_library(
    name = "spektrafilmfast_lib",
    module_name = "SpektraFilmFast",
    srcs = glob([
        "Sources/SpektraFilmFast/**/*.swift",
    ]),
    deps = [
        ":spektra_bridge",
        ":studio_core_bridge",
        ":semantic_mask_native",
    ],
    resources = glob([
        "Sources/SpektraFilmFast/ImageProcessing/*.metal",
    ]),
)

# Metal shader sources (bundled as resources, compiled at runtime via device.makeLibrary)
apple_resource_group(
    name = "metal_shaders",
    resources = glob(["Sources/SpektraFilmFast/ImageProcessing/*.metal"]),
)

# =========================================================================
# Main Executable
# =========================================================================

swift_binary(
    name = "SpektraFilmStudio_bin",
    main = "Sources/SpektraFilmFast/SpektraFilmFastApp.swift",
    deps = [
        ":spektrafilmfast_lib",
    ],
    linkopts = [
        "-L/Users/A1990/Downloads/SpektraFilmStudio/.build/native",
        "-lSpektraFilmNativeCore",
        "-L/Users/A1990/Downloads/SpektraFilmStudio/.build/spektrastudio-core/x86_64-apple-darwin/release",
        "-lspektrastudio_core",
        "-Lexternal/onnxruntime/lib",
        "-lonnxruntime",
        "-Xlinker", "-rpath", "-Xlinker", "@executable_path/../Frameworks",
        "-lc++",
        "-lsqlite3",
    ],
    copts = [
        "-DSWIFT_PACKAGE",
        "-DDEBUG",
        "-DSWIFT_MODULE_RESOURCE_BUNDLE_AVAILABLE",
    ],
    swiftopts = [
        "-swift-version", "6",
        "-Onone",
        "-g",
        "-enable-testing",
        "-D", "SWIFT_PACKAGE",
        "-D", "DEBUG",
        "-D", "SWIFT_MODULE_RESOURCE_BUNDLE_AVAILABLE",
    ],
)

# =========================================================================
# macOS App Bundle
# =========================================================================

macos_application(
    name = "SpektraFilmStudio",
    bundle_id = "org.spektrafilm.fast",
    families = ["macos"],
    minimum_os_version = "15.0",
    infoplists = ["Info.plist"],
    binaries = [":SpektraFilmStudio_bin"],
    resources = [
        ":metal_shaders",
        "//Resources:all_resources",
    ],
    entitlements = "scripts/SpektraFilm.entitlements",
    linkopts = [
        "-framework", "AppKit",
        "-framework", "CoreGraphics",
        "-framework", "CoreImage",
        "-framework", "ImageIO",
        "-framework", "Metal",
        "-framework", "MetalKit",
        "-framework", "MetalPerformanceShaders",
        "-framework", "QuartzCore",
        "-framework", "UniformTypeIdentifiers",
        "-framework", "Vision",
    ],
    minimum_os_version = "15.0",
)

# =========================================================================
# Resources
# =========================================================================

apple_resource_group(
    name = "all_resources",
    resources = glob([
        "Resources/**",
    ]),
)